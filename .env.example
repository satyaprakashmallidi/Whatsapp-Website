# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Client-Side Token Encryption
# Uncomment and set this if you want to encrypt WhatsApp tokens before storing
# Generate a key with: openssl rand -hex 32
# WARNING: This key should be stored securely and never committed to git
# VITE_ENCRYPTION_KEY=your-32-character-encryption-key-here

# Note: The VITE_ prefix makes these variables available in your frontend code
# Do NOT put sensitive backend-only secrets here - those belong in Supabase Edge Functions
